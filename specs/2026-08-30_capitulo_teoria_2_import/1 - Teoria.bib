	file = {Clark e Gibbs - 2020 - Voices of social dislocation, lost work and econom.pdf:C\:\\Users\\leoau\\Zotero\\storage\\EFQV8248\\Clark e Gibbs - 2020 - Voices of social dislocation, lost work and econom.pdf:application/pdf},
