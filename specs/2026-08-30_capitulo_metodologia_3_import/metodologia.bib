	note = {PRIORIDADE},
	keywords = {Case study, Methodology, Qualitative methodology, Process Tracing},
	pages = {455--476},
	file = {Bennett and Elman - 2006 - QUALITATIVE RESEARCH Recent Developments in Case .pdf:C\:\\Users\\leoau\\Zotero\\storage\\IH565MTH\\Bennett and Elman - 2006 - QUALITATIVE RESEARCH Recent Developments in Case .pdf:application/pdf},
