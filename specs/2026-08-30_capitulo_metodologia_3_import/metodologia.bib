@article{bennett_qualitative_2006,
	title = {{QUALITATIVE} {RESEARCH}: {Recent} {Developments} in {Case} {Study} {Methods}},
	volume = {9},
	issn = {1094-2939, 1545-1577},
	shorttitle = {{QUALITATIVE} {RESEARCH}},
	url = {https://www.annualreviews.org/doi/10.1146/annurev.polisci.8.082103.104918},
	doi = {10.1146/annurev.polisci.8.082103.104918},
	abstract = {▪ Abstract  This article surveys the extensive new literature that has brought about a renaissance of qualitative methods in political science over the past decade. It reviews this literature's focus on causal mechanisms and its emphasis on process tracing, a key form of within-case analysis, and it discusses the ways in which case-selection criteria in qualitative research differ from those in statistical research. Next, the article assesses how process tracing and typological theorizing help address forms of complexity, such as path dependence and interaction effects. The article then addresses the method of fuzzy-set analysis. The article concludes with a call for greater attention to means of combining alternative methodological approaches in research projects.},
	language = {en},
	number = {1},
	urldate = {2023-07-11},
	journal = {Annual Review of Political Science},
	author = {Bennett, Andrew and Elman, Colin},
	month = jun,
