	file = {Cano - 2012 - A desindustrialização no Brasil.pdf:C\:\\Users\\leoau\\Zotero\\storage\\ZUMCD9YY\\Cano - 2012 - A desindustrialização no Brasil.pdf:application/pdf},
}

