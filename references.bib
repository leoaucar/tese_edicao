	file = {Gibbs - 2018 - The Moral Economy of the Scottish Coalfields Mana.pdf:C\:\\Users\\leoau\\Zotero\\storage\\69SXZ9B4\\Gibbs - 2018 - The Moral Economy of the Scottish Coalfields Mana.pdf:application/pdf},
}

@article{clingingsmith_deindustrialization_2008,
