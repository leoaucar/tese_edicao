	file = {Scheiring e King - 2023 - Deindustrialization, social disintegration, and he.pdf:C\:\\Users\\leoau\\Zotero\\storage\\7UNEKAYE\\Scheiring e King - 2023 - Deindustrialization, social disintegration, and he.pdf:application/pdf},
}

