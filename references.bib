@article{da_silva_ferreira_modernizacao_2024,
	title = {A modernização da agricultura em {São} {Paulo} no início do século {XX}: ciência e política em conexão},
	volume = {27},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2525-8184, 1519-3314},
	shorttitle = {A modernização da agricultura em {São} {Paulo} no início do século {XX}},
	url = {https://www.hehe.org.br/index.php/rabphe/article/view/920},
	doi = {10.29182/hehe.v27i1.920},
	abstract = {In this paper, we analyze some laws and decrees published during Fernando Prestes de Albuquerque's (1898-1900) and Jorge Tibiriçá Piratininga's (1904-1908) administrations of the state of São Paulo. The text is the result of a bibliographical research with analysis of official documents found in the collections of respected institutions in the field of agricultural production in São Paulo, such as the Instituto Agronômico de Campinas (IAC) and the Escola Superior de Agricultura Luiz de Queiroz (Esalq). Its goal is to discuss the relevance that science – fundamentally agronomics, during this period – had in guiding the policy for modernizing agriculture in São Paulo. It is known that, in the first decade of the 20th century, São Paulo went through a crisis led by the overproduction of coffee. This situation made the vanguard of this period's oligarchy doubt the viability of this culture in the state, seeking a solution that would benefit them. Therefore, in the first decade of the 20th century, science and politics were connected at this site, as revealed by our extensive documental and bibliographical research. In other words, the scientific Zeitgeist and method directly influenced political actions, what might be read as an important message in the present times, as we see a strong denial of science and politics.},
	language = {pt},
	number = {1},
	urldate = {2024-10-17},
	journal = {História Econômica \& História de Empresas},
	author = {Da Silva Ferreira, Aldenor and Roberto Ferraro, Mário and Raffi Menegaldo Ferreira, Luciana},
	month = may,
	year = {2024},
	pages = {166--206},
	file = {Da Silva Ferreira et al. - 2024 - A modernização da agricultura em São Paulo no iníc.pdf:C\:\\Users\\leoau\\Zotero\\storage\\66SWE34Y\\Da Silva Ferreira et al. - 2024 - A modernização da agricultura em São Paulo no iníc.pdf:application/pdf},
}

