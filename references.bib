}

@incollection{orum_deindustrialization_2019,
	edition = {1},
	title = {Deindustrialization},
	isbn = {978-1-118-56845-3 978-1-118-56844-6},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/9781118568446.eurs0448},
	abstract = {Abstract
            A generic expression used to refer to the loss of significant industrial activities in a city, deindustrialization is a classic phenomenon of European and North American cities, which had strong economic growth in the late nineteenth century and much of the twentieth, as concentrations of many major factories in the booming industrial sectors throughout this period. However, in the last few decades the cities and regions of steel, chemical, shipbuilding, and textile industries, which used to employ a large number of workers, have suffered from the consequences of factory closures and mass unemployment. High labor prices and the obsolescence of many facilities are causes of this process. It has created landscapes of abandoned industrial estates and large isolated plants, which continue through progressively empty residential neighborhoods. Deindustrialization is reflected in urban decline and in the emergence of new categories of analysis, such as the shrinking city.},
	language = {en},
	urldate = {2024-01-14},
	booktitle = {The {Wiley} {Blackwell} {Encyclopedia} of {Urban} and {Regional} {Studies}},
